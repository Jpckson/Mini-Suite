Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertImage\shell\tiff"; ValueType: string; ValueName: "MUIVerb"; ValueData: "to TIFF"
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertImage\shell\tiff\command"; ValueType: string; ValueData: "wscript.exe ""{app}\convert-hidden.vbs"" tiff ""%1"" ""{app}"""
