[Setup]
AppName=Mini Convert
AppVersion=1.0
DefaultDirName={autopf}\MiniConvert
DefaultGroupName=Mini Convert
PrivilegesRequired=lowest
OutputBaseFilename=MiniConvert
Compression=lzma2/ultra64
SolidCompression=yes
SetupIconFile=logo.ico

[Files]
Source: "convert.ps1";          DestDir: "{app}"
Source: "convert-hidden.vbs";   DestDir: "{app}"
Source: "ffmpeg.exe";           DestDir: "{app}"
Source: "logo.ico"; DestDir: "{app}"

[Registry]
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertImage"; ValueType: string; ValueName: "MUIVerb"; ValueData: "Convert"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertImage"; ValueType: string; ValueName: "SubCommands"; ValueData: ""
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertImage\shell\jpg"; ValueType: string; ValueName: "MUIVerb"; ValueData: "to JPG"
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertImage\shell\jpg\command"; ValueType: string; ValueData: "wscript.exe ""{app}\convert-hidden.vbs"" jpg ""%1"" ""{app}"""
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertImage\shell\png"; ValueType: string; ValueName: "MUIVerb"; ValueData: "to PNG"
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertImage\shell\png\command"; ValueType: string; ValueData: "wscript.exe ""{app}\convert-hidden.vbs"" png ""%1"" ""{app}"""
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertImage\shell\webp"; ValueType: string; ValueName: "MUIVerb"; ValueData: "to WEBP"
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertImage\shell\webp\command"; ValueType: string; ValueData: "wscript.exe ""{app}\convert-hidden.vbs"" webp ""%1"" ""{app}"""
